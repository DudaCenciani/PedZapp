@using System.Globalization
@model PedZapp.ViewModels.Mesa.ComandaViewModel
@{ ViewData["Title"] = "Fechar conta"; var cultura = new CultureInfo("pt-BR"); }
<link rel="stylesheet" href="~/css/fechar-conta.css" asp-append-version="true" />
<main class="fechar-conta-page">
    @* Mantém um retorno direto ao painel sem alterar o fechamento da conta. *@
    <partial name="_BotaoVoltarPainel" model="Model.Slug" />
    <header class="fechar-conta-header"><div><p>Fechamento da conta</p><h1>@Model.NomeMesa <span>Comanda @Model.NumeroComanda</span></h1><small>Responsável: @Model.Funcionario · Aberta às @Model.DataAbertura.ToLocalTime().ToString("HH:mm")</small></div><strong>R$ @Model.Total.ToString("N2", cultura)<small>Total atual</small></strong></header>
    @if (TempData["Erro"] is string erro) { <p class="fechar-erro">@erro</p> }
    <section class="fechar-grid"><section class="fechar-card"><div class="fechar-title"><h2>Resumo do consumo</h2><a asp-action="ImprimirConta" asp-route-slug="@Model.Slug" asp-route-mesaId="@Model.MesaId" target="_blank" class="btn-secundario">Imprimir conta</a></div>@foreach (var item in Model.Itens) { <article class="conta-item"><div><strong>@item.Quantidade× @item.Nome</strong><p>@(item.Adicionais.Any() ? string.Join(" · ", item.Adicionais) : "Sem adicionais")</p>@if (!string.IsNullOrWhiteSpace(item.Observacao)) { <p>Obs.: @item.Observacao</p> }<small>@(item.EnviadoParaCozinha ? "Enviado à cozinha" : "Pendente")</small></div><div><small>R$ @item.PrecoUnitario.ToString("N2", cultura) un.</small><strong>R$ @item.Subtotal.ToString("N2", cultura)</strong></div></article> }</section>
        <section class="fechar-card"><h2>Pagamento</h2><form asp-action="ConfirmarFechamento" asp-route-slug="@Model.Slug" asp-route-mesaId="@Model.MesaId" method="post" data-fechamento-form>@Html.AntiForgeryToken()<label class="check"><input name="TaxaServicoAplicada" type="checkbox" value="true" @(Model.TaxaServicoAplicada ? "checked" : null) data-taxa-ativa /> Incluir taxa de serviço</label><label>Percentual<input name="PercentualTaxaServico" value="@Model.PercentualTaxaServico.ToString(CultureInfo.InvariantCulture)" inputmode="decimal" data-percentual-taxa /></label><label>Forma de pagamento<select name="FormaPagamentoId" required data-forma-pagamento><option value="">Selecione</option>@foreach (var forma in Model.FormasPagamento) { <option value="@forma.Id" data-aceita-troco="@forma.AceitaTroco.ToString().ToLowerInvariant()">@forma.Nome</option> }</select></label><div class="troco-field" data-troco-field hidden><label class="check"><input name="PrecisaTroco" type="checkbox" value="true" data-precisa-troco /> Precisa de troco</label><label data-troco-valor hidden>Troco para quanto?<input name="TrocoPara" inputmode="decimal" placeholder="0,00" /></label></div><div class="totais"><p><span>Subtotal</span><strong data-subtotal="@Model.Subtotal.ToString(CultureInfo.InvariantCulture)">R$ @Model.Subtotal.ToString("N2", cultura)</strong></p><p><span>Taxa de serviço</span><strong data-taxa-valor>R$ @Model.ValorTaxaServico.ToString("N2", cultura)</strong></p><p><span>Total final</span><strong data-total-valor>R$ @Model.Total.ToString("N2", cultura)</strong></p></div><p class="aviso">Itens pendentes ou pedidos ainda em produção impedem o fechamento.</p><button class="btn-principal" type="submit">Confirmar pagamento e fechar mesa</button><a asp-action="Comanda" asp-route-slug="@Model.Slug" asp-route-mesaId="@Model.MesaId" class="btn-secundario">Cancelar</a></form></section></section>
</main>
<script src="~/js/mesas.js" asp-append-version="true"></script>
