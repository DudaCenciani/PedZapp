@using PedZapp.Enums
@model PedZapp.ViewModels.Mesa.MesasIndexViewModel
@{ ViewData["Title"] = "Mesas e comandas"; }
<link rel="stylesheet" href="~/css/mesas.css" asp-append-version="true" />
<main class="mesas-page">@* Centraliza a navegação de retorno e preserva o slug atual. *@<partial name="_BotaoVoltarPainel" model="Model.Slug" /><header class="mesas-header"><div><p>Operação · @Model.Slug</p><h1>Mesas e comandas</h1><span>Gerencie o atendimento presencial da sua empresa</span></div><a href="#nova-mesa" class="mesa-primary">+ Nova mesa</a></header>
@if (TempData["Sucesso"] is string sucesso) { <p class="mesa-feedback">@sucesso</p> }@if (TempData["Erro"] is string erro) { <p class="mesa-error">@erro</p> }
<section class="mesa-metrics"><article><strong>@Model.TotalMesas</strong><span>Mesas</span></article><article><strong>@Model.TotalLivres</strong><span>Livres</span></article><article><strong>@Model.TotalOcupadas</strong><span>Ocupadas</span></article></section>
<section id="nova-mesa" class="mesa-form"><h2>Nova mesa</h2><form asp-action="Criar" asp-route-slug="@Model.Slug" method="post">@Html.AntiForgeryToken()<input asp-for="NovaMesa.Nome" placeholder="Nome da mesa" /><input asp-for="NovaMesa.Numero" placeholder="Número" /><input asp-for="NovaMesa.Capacidade" placeholder="Capacidade" /><input asp-for="NovaMesa.OrdemExibicao" placeholder="Ordem" /><input asp-for="NovaMesa.Observacao" placeholder="Observação" /><label><input asp-for="NovaMesa.Ativa" /> Ativa</label><button class="mesa-primary" type="submit">Cadastrar mesa</button></form></section>
<section class="mesa-grid">@foreach (var mesa in Model.Mesas) { <article class="mesa-card mesa-card--@mesa.Status.ToString().ToLowerInvariant()"><div class="mesa-card__head"><h2>@mesa.Nome</h2><span>@mesa.Status</span></div><p>@(mesa.Numero.HasValue ? $"Mesa {mesa.Numero}" : "Sem número") · @(mesa.Capacidade.HasValue ? $"{mesa.Capacidade} lugares" : "Capacidade não informada")</p>@if (mesa.Status == StatusMesa.Ocupada) { <p>Aberta: @mesa.DataAbertura?.ToLocalTime().ToString("HH:mm") · @mesa.Funcionario</p><strong>R$ @mesa.TotalAtual.ToString("N2") · @mesa.QuantidadeItens itens</strong> }<div class="mesa-actions">@if (mesa.Status == StatusMesa.Livre) { <form asp-action="Abrir" asp-route-slug="@Model.Slug" asp-route-mesaId="@mesa.Id" method="post">@Html.AntiForgeryToken()<button class="mesa-primary">Abrir comanda</button></form> }@if (mesa.Status == StatusMesa.Ocupada) { <a asp-action="Comanda" asp-route-slug="@Model.Slug" asp-route-mesaId="@mesa.Id">Ver consumo</a> }<form asp-action="AlterarAtivacao" asp-route-slug="@Model.Slug" asp-route-mesaId="@mesa.Id" asp-route-ativa="@(!mesa.Ativa)" method="post">@Html.AntiForgeryToken()<button type="submit">@(mesa.Ativa ? "Inativar" : "Reativar")</button></form></div></article> }</section></main>
