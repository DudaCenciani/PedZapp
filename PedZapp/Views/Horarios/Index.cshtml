@model PedZapp.ViewModels.Horario.HorariosIndexViewModel
@{ ViewData["Title"] = "Horários de funcionamento"; }
<link rel="stylesheet" href="~/css/horarios.css" asp-append-version="true" />
@* Insere o retorno ao painel antes da área de horários, usando o slug do ViewModel. *@
<partial name="_BotaoVoltarPainel" model="Model.Slug" />
<main class="horarios-page"><header class="horarios-header"><div><p class="horarios-eyebrow">Operação · @Model.Slug</p><h1>Horários de funcionamento</h1><p>Defina quando sua empresa aceita pedidos.</p></div><span class="horarios-status @(Model.AbertoAgora ? "horarios-status--open" : "horarios-status--closed")">@(Model.AbertoAgora ? "Aberto agora" : "Fechado agora")</span></header>
@if(TempData["Sucesso"] is string sucesso){<div class="horarios-feedback" role="status">@sucesso</div>}
<form asp-action="Salvar" asp-route-slug="@Model.Slug" method="post">@Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger horarios-errors"></div><section class="horarios-lista">@for(var i=0;i<Model.Dias.Count;i++){var dia=Model.Dias[i];<article class="horario-dia" data-row><input type="hidden" name="Dias[@i].Id" value="@dia.Id"/><input type="hidden" name="Dias[@i].DiaSemana" value="@((int)dia.DiaSemana)"/><div class="horario-dia__head"><h2>@DiaTexto(dia.DiaSemana)</h2><label class="horario-toggle"><input type="checkbox" name="Dias[@i].Fechado" value="true" checked="@dia.Fechado" data-fechado/> Fechado</label></div><div class="horario-periodos"><div data-horario><label>Abertura<input name="Dias[@i].Abertura1" type="time" value="@(dia.Abertura1?.ToString("HH\\:mm"))"/></label><label>Fechamento<input name="Dias[@i].Fechamento1" type="time" value="@(dia.Fechamento1?.ToString("HH\\:mm"))"/></label></div><button type="button" class="btn horario-add" data-add>+ Adicionar segundo período</button><div data-segundo class="horario-segundo @(dia.Abertura2.HasValue ? string.Empty : "is-hidden")"><div data-horario><label>Abertura<input name="Dias[@i].Abertura2" type="time" value="@(dia.Abertura2?.ToString("HH\\:mm"))"/></label><label>Fechamento<input name="Dias[@i].Fechamento2" type="time" value="@(dia.Fechamento2?.ToString("HH\\:mm"))"/></label></div><button type="button" class="btn horario-remove" data-remove>Remover segundo período</button></div></div><span class="horario-badge @(dia.Fechado ? "horario-badge--closed" : "horario-badge--open")" data-badge>@(dia.Fechado ? "Fechado" : "Aberto")</span></article>}</section><div class="horarios-save"><p>Horários que atravessam a meia-noite ainda não são suportados.</p><button type="submit" class="btn horarios-primary">Salvar alterações</button></div></form></main>
@functions { private static string DiaTexto(PedZapp.Enums.DiaSemana dia) => dia switch { PedZapp.Enums.DiaSemana.Segunda => "Segunda-feira", PedZapp.Enums.DiaSemana.Terca => "Terça-feira", PedZapp.Enums.DiaSemana.Quarta => "Quarta-feira", PedZapp.Enums.DiaSemana.Quinta => "Quinta-feira", PedZapp.Enums.DiaSemana.Sexta => "Sexta-feira", PedZapp.Enums.DiaSemana.Sabado => "Sábado", _ => "Domingo" }; }
@section Scripts { <script>document.querySelectorAll('[data-row]').forEach(function(row){var fechado=row.querySelector('[data-fechado]'),campos=row.querySelectorAll('[data-horario] input'),badge=row.querySelector('[data-badge]'),segundo=row.querySelector('[data-segundo]');function estado(){campos.forEach(function(c){c.disabled=fechado.checked;});row.querySelector('[data-add]').disabled=fechado.checked;badge.textContent=fechado.checked?'Fechado':'Aberto';badge.classList.toggle('horario-badge--closed',fechado.checked);badge.classList.toggle('horario-badge--open',!fechado.checked);}fechado.addEventListener('change',estado);row.querySelector('[data-add]').addEventListener('click',function(){segundo.classList.remove('is-hidden');});row.querySelector('[data-remove]').addEventListener('click',function(){segundo.querySelectorAll('input').forEach(function(i){i.value='';});segundo.classList.add('is-hidden');});estado();});</script> }
