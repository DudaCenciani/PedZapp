@model PedZapp.ViewModels.Configuracao.ConfiguracaoEmpresaViewModel
@{ ViewData["Title"] = "Configurações da empresa"; }
@* A tela usa a rota por slug do controller e nunca envia EmpresaId pelo formulário. *@
<link rel="stylesheet" href="~/css/configuracoes-empresa.css" asp-append-version="true" />
<main class="config-page">
    <partial name="_BotaoVoltarPainel" model="Model.Slug" />
    <header class="config-header"><div><p class="config-eyebrow">Administração</p><h1>Configurações da empresa</h1><p>Dados, identidade visual e preferências operacionais.</p></div><span class="config-slug">/@Model.Slug</span></header>
    @if (TempData["Sucesso"] is string sucesso) { <div class="config-feedback" role="status">@sucesso</div> }
    @* asp-route-slug é indispensável para gerar /{slug}/configuracoes/salvar em vez da rota convencional inexistente. *@
    <form asp-action="Salvar" asp-route-slug="@Model.Slug" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()<div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <section class="config-card"><h2>Geral</h2><div class="config-grid"><label>Nome fantasia<input asp-for="NomeFantasia"/></label><label>Razão social<input asp-for="RazaoSocial"/></label><label>CPF/CNPJ<input asp-for="CpfCnpj"/></label><label>E-mail<input asp-for="Email" type="email"/></label><label>Telefone<input asp-for="Telefone"/></label><label>WhatsApp<input asp-for="WhatsApp"/></label><label class="config-toggle"><input asp-for="LojaPublicaAberta"/> Loja pública aberta</label><label class="config-wide">Descrição<textarea asp-for="Descricao" rows="3"></textarea></label></div></section>
        <section class="config-card"><h2>Contato e endereço</h2><div class="config-grid"><label>Endereço<input asp-for="Endereco"/></label><label>Número<input asp-for="Numero"/></label><label>Bairro<input asp-for="Bairro"/></label><label>Cidade<input asp-for="Cidade"/></label><label>Estado<input asp-for="Estado" maxlength="2"/></label><label>CEP<input asp-for="CEP"/></label><label>Telefone de atendimento<input asp-for="TelefoneAtendimento"/></label><label>WhatsApp de atendimento<input asp-for="WhatsAppAtendimento"/></label></div></section>
        <section class="config-card"><h2>Identidade visual</h2><div class="config-grid">@if(Model.PossuiLogo){<div class="config-wide"><img src="@Url.Action("Logo","Imagens",new{slug=Model.Slug})" alt="Logo atual" loading="lazy" style="max-height:96px"/><label class="config-toggle"><input asp-for="RemoverLogo"/> Remover logo atual</label></div>}<label class="config-wide">Trocar logo (JPG, PNG ou WebP, até 2 MB)<input asp-for="LogoArquivo" type="file" accept="image/jpeg,image/png,image/webp"/></label><label>Cor primária<input asp-for="CorPrimaria"/></label><label>Cor secundária<input asp-for="CorSecundaria"/></label><label>Cor de destaque<input asp-for="CorDestaque"/></label><label>Nome no cardápio<input asp-for="NomeExibicaoCardapio"/></label><label>Texto curto<input asp-for="TextoCurtoCardapio"/></label><label class="config-toggle"><input asp-for="ExibirLogo"/> Exibir logo</label><label class="config-toggle"><input asp-for="ExibirDescricao"/> Exibir descrição</label></div></section>
        <section class="config-card"><h2>Operação</h2><div class="config-grid"><label class="config-toggle"><input asp-for="AceitaPedidos"/> Aceita pedidos</label><label>Pedido mínimo<input asp-for="PedidoMinimo" type="number" min="0" step="0.01"/></label><label>Tempo médio de preparo<input asp-for="TempoMedioPreparoMinutos" type="number" min="1" max="1440"/></label><label class="config-toggle"><input asp-for="AtendimentoMesasAtivo"/> Atendimento em mesas ativo</label><label class="config-toggle"><input asp-for="ImpressaoAutomaticaCozinha"/> Impressão automática da cozinha</label><label>Fluxo de pedidos<select asp-for="TipoFluxoPedido"><option value="1">Fluxo completo</option><option value="2">Fluxo simplificado</option></select></label><label class="config-wide">Mensagem automática<textarea asp-for="MensagemAutomatica" rows="3"></textarea></label></div></section>
        <section class="config-card"><h2>Mensagens e redes sociais</h2><div class="config-grid"><label>Instagram<input asp-for="Instagram" type="url"/></label><label>Facebook<input asp-for="Facebook" type="url"/></label><label class="config-wide">Observações internas<textarea asp-for="ObservacoesInternas" rows="3"></textarea></label></div></section>
        <div class="config-save"><button class="btn config-primary" type="submit">Salvar alterações</button></div>
    </form>
</main>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
