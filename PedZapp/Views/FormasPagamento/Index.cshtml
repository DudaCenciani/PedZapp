@using PedZapp.Enums
@model PedZapp.ViewModels.FormaPagamento.FormasPagamentoIndexViewModel
@{ ViewData["Title"] = "Formas de pagamento"; }
<link rel="stylesheet" href="~/css/formas-pagamento.css" asp-append-version="true" />
<main class="formas-page">
    @* Reutiliza o botão comum para voltar ao painel do mesmo slug. *@
    <partial name="_BotaoVoltarPainel" model="Model.Slug" />
<header class="formas-header"><div><p class="formas-eyebrow">Operação · @Model.Slug</p><h1>Formas de pagamento</h1><p>Escolha como seus clientes poderão pagar na entrega ou retirada.</p></div><button class="btn formas-primary" type="button" data-bs-toggle="modal" data-bs-target="#novaFormaModal"><span aria-hidden="true">+</span> Nova forma</button></header>
@if(TempData["Sucesso"] is string sucesso){<div class="formas-feedback" role="status">@sucesso</div>}
<p class="formas-count"><strong>@Model.Formas.Count(f => f.Ativa)</strong> forma@(Model.Formas.Count(f => f.Ativa)==1 ? string.Empty : "s") ativa@(Model.Formas.Count(f => f.Ativa)==1 ? string.Empty : "s")</p>
<section class="formas-grid" aria-label="Formas de pagamento">@foreach(var forma in Model.Formas){<article class="forma-card"><div class="forma-card__head"><span class="forma-icon" aria-hidden="true">@(forma.Tipo == TipoFormaPagamento.Dinheiro ? "R$" : forma.Tipo == TipoFormaPagamento.CartaoCredito ? "▣" : forma.Tipo == TipoFormaPagamento.CartaoDebito ? "▤" : forma.Tipo == TipoFormaPagamento.Pix ? "◈" : "＋")</span><span class="forma-status @(forma.Ativa ? "forma-status--active" : "forma-status--inactive")">@(forma.Ativa ? "Ativa" : "Inativa")</span></div><h2>@forma.Nome</h2><p class="forma-tipo">@TipoTexto(forma.Tipo)</p><div class="forma-badges"><span>Pagamento na entrega</span>@if(forma.AceitaTroco){<span>Aceita troco</span>}</div>@if(forma.Tipo == TipoFormaPagamento.Pix){<p class="forma-pix-note">Pix na entrega/retirada. QR Code online será disponibilizado futuramente.</p>}@if(!string.IsNullOrWhiteSpace(forma.Observacao)){<p class="forma-observacao">@forma.Observacao</p>}<small>Ordem de exibição: @forma.OrdemExibicao</small><div class="forma-actions"><button class="btn forma-edit" type="button" data-bs-toggle="modal" data-bs-target="#editarForma-@forma.Id"><span aria-hidden="true">✎</span> Editar</button>@if(forma.Ativa){<button class="btn forma-inactivate" type="button" data-bs-toggle="modal" data-bs-target="#inativarForma-@forma.Id"><span aria-hidden="true">◷</span> Inativar</button>}</div></article>
<div class="modal fade" id="editarForma-@forma.Id" tabindex="-1" aria-labelledby="editarFormaTitulo-@forma.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content formas-modal" asp-action="Editar" asp-route-slug="@Model.Slug" asp-route-id="@forma.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="editarFormaTitulo-@forma.Id">Editar forma de pagamento</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body formas-form"><div><label for="edit-tipo-@forma.Id">Tipo</label><select id="edit-tipo-@forma.Id" name="Tipo" data-tipo-select><option value="0" selected="@(forma.Tipo == TipoFormaPagamento.Dinheiro)">Dinheiro</option><option value="1" selected="@(forma.Tipo == TipoFormaPagamento.CartaoCredito)">Cartão de crédito</option><option value="2" selected="@(forma.Tipo == TipoFormaPagamento.CartaoDebito)">Cartão de débito</option><option value="3" selected="@(forma.Tipo == TipoFormaPagamento.Pix)">Pix</option><option value="4" selected="@(forma.Tipo == TipoFormaPagamento.Outro)">Outro</option></select></div><div><label for="edit-nome-@forma.Id">Nome</label><input id="edit-nome-@forma.Id" name="Nome" maxlength="160" required value="@forma.Nome"/></div><div><label for="edit-ordem-@forma.Id">Ordem de exibição</label><input id="edit-ordem-@forma.Id" name="OrdemExibicao" type="number" min="0" value="@forma.OrdemExibicao"/></div><div class="formas-wide"><label for="edit-observacao-@forma.Id">Observação</label><textarea id="edit-observacao-@forma.Id" name="Observacao" maxlength="500" rows="3">@forma.Observacao</textarea></div><label class="formas-toggle formas-wide" data-troco><input type="checkbox" name="AceitaTroco" value="true" checked="@forma.AceitaTroco"/> Aceita troco</label><label class="formas-toggle formas-wide"><input type="checkbox" name="Ativa" value="true" checked="@forma.Ativa"/> Forma ativa</label></div><div class="modal-footer"><button type="button" class="btn formas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn formas-primary">Salvar forma</button></div></form></div></div>
<div class="modal fade" id="inativarForma-@forma.Id" tabindex="-1" aria-labelledby="inativarFormaTitulo-@forma.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content formas-modal" asp-action="Inativar" asp-route-slug="@Model.Slug" asp-route-id="@forma.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="inativarFormaTitulo-@forma.Id">Inativar forma</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p>Deseja inativar <strong>@forma.Nome</strong>?</p><p class="formas-muted">Ela deixará de aparecer para novos pedidos, preservando o histórico futuro.</p></div><div class="modal-footer"><button type="button" class="btn formas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn formas-danger">Inativar forma</button></div></form></div></div>}</section>
</main>
<div class="modal fade" id="novaFormaModal" tabindex="-1" aria-labelledby="novaFormaTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content formas-modal" asp-action="Criar" asp-route-slug="@Model.Slug" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="novaFormaTitulo">Nova forma de pagamento</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body formas-form"><div asp-validation-summary="ModelOnly" class="text-danger formas-wide"></div><div><label asp-for="NovaForma.Tipo">Tipo</label><select asp-for="NovaForma.Tipo" data-tipo-select><option value="0">Dinheiro</option><option value="1">Cartão de crédito</option><option value="2">Cartão de débito</option><option value="3">Pix</option><option value="4">Outro</option></select></div><div><label asp-for="NovaForma.Nome">Nome</label><input asp-for="NovaForma.Nome" required/></div><div><label asp-for="NovaForma.OrdemExibicao">Ordem de exibição</label><input asp-for="NovaForma.OrdemExibicao" type="number" min="0"/></div><div class="formas-wide"><label asp-for="NovaForma.Observacao">Observação</label><textarea asp-for="NovaForma.Observacao" rows="3"></textarea></div><label class="formas-toggle formas-wide" data-troco><input asp-for="NovaForma.AceitaTroco"/> Aceita troco</label><label class="formas-toggle formas-wide"><input asp-for="NovaForma.Ativa"/> Forma ativa</label></div><div class="modal-footer"><button type="button" class="btn formas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn formas-primary">Salvar forma</button></div></form></div></div>
@functions { private static string TipoTexto(TipoFormaPagamento tipo) => tipo switch { TipoFormaPagamento.Dinheiro => "Dinheiro", TipoFormaPagamento.CartaoCredito => "Cartão de crédito", TipoFormaPagamento.CartaoDebito => "Cartão de débito", TipoFormaPagamento.Pix => "Pix na entrega/retirada", _ => "Outro" }; }
@section Scripts { <partial name="_ValidationScriptsPartial" /><script>document.querySelectorAll('[data-tipo-select]').forEach(function(select){var form=select.closest('form'),troco=form.querySelector('[data-troco]');function atualizar(){var dinheiro=select.value==='0';troco.hidden=!dinheiro;troco.querySelector('input').disabled=!dinheiro;if(!dinheiro)troco.querySelector('input').checked=false;}select.addEventListener('change',atualizar);atualizar();});</script> }
