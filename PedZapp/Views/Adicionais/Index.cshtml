@using System.Globalization
@model PedZapp.ViewModels.Adicional.AdicionaisIndexViewModel
@{ ViewData["Title"] = "Adicionais"; var cultura = new CultureInfo("pt-BR"); }
<link rel="stylesheet" href="~/css/adicionais.css" asp-append-version="true" />
<main class="adicionais-page">
    @* Reutiliza o botão comum para voltar ao painel do mesmo slug. *@
    <partial name="_BotaoVoltarPainel" model="Model.Slug" />
    <header class="adicionais-header"><div><p class="adicionais-eyebrow">Cardápio · @Model.Slug</p><h1>Adicionais</h1><p>Gerencie os complementos disponíveis no cardápio.</p></div><button class="btn adicionais-primary" type="button" data-bs-toggle="modal" data-bs-target="#novoAdicionalModal"><span aria-hidden="true">+</span> Novo Adicional</button></header>
    @if (TempData["Sucesso"] is string sucesso) { <div class="adicionais-feedback" role="status">@sucesso</div> }
    <form class="adicionais-filtros" method="get" asp-action="Index" asp-route-slug="@Model.Slug"><input name="busca" value="@Model.Busca" placeholder="Buscar por nome" aria-label="Buscar adicional" /><select name="categoriaId" aria-label="Filtrar por categoria"><option value="">Todas as categorias</option>@foreach (var categoria in Model.Categorias) { <option value="@categoria.Id" selected="@(categoria.Id == Model.CategoriaId)">@categoria.Nome</option> }</select><select name="status" aria-label="Filtrar por status"><option value="">Todos os status</option><option value="ativo" selected="@(Model.Status == "ativo")">Ativos</option><option value="inativo" selected="@(Model.Status == "inativo")">Inativos</option></select><button class="btn adicionais-filter-button" type="submit">Filtrar</button></form>
    @if (!Model.Adicionais.Any()) { <section class="adicionais-empty"><span aria-hidden="true">＋</span><h2>Nenhum adicional cadastrado.</h2><p>Crie adicionais e vincule-os às categorias do seu cardápio.</p><button class="btn adicionais-primary" type="button" data-bs-toggle="modal" data-bs-target="#novoAdicionalModal">Cadastrar primeiro adicional</button></section> }
    else { <section class="adicionais-grid" aria-label="Adicionais cadastrados">@foreach (var adicional in Model.Adicionais) { <article class="adicional-card"><div class="adicional-card__head"><h2>@adicional.Nome</h2><span class="adicional-status @(adicional.Ativo ? "adicional-status--active" : "adicional-status--inactive")">@(adicional.Ativo ? "Ativo" : "Inativo")</span></div><p class="adicional-card__description">@(string.IsNullOrWhiteSpace(adicional.Descricao) ? "Sem descrição cadastrada." : adicional.Descricao)</p><strong class="adicional-card__price">R$ @adicional.Preco.ToString("N2", cultura)</strong><div class="adicional-badges">@foreach (var categoria in adicional.Categorias) { <span>@categoria</span> }</div><small>Máximo de seleção: @(adicional.MaximoSelecao?.ToString() ?? "Sem limite")</small><div class="adicional-actions"><button class="btn adicional-edit" type="button" data-bs-toggle="modal" data-bs-target="#editarAdicional-@adicional.Id"><span aria-hidden="true">✎</span> Editar</button><button class="btn adicional-delete" type="button" data-bs-toggle="modal" data-bs-target="#excluirAdicional-@adicional.Id"><span aria-hidden="true">⌫</span> Excluir</button></div></article>
        <div class="modal fade" id="editarAdicional-@adicional.Id" tabindex="-1" aria-labelledby="editarAdicionalTitulo-@adicional.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content adicionais-modal" asp-action="Editar" asp-route-slug="@Model.Slug" asp-route-id="@adicional.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="editarAdicionalTitulo-@adicional.Id">Editar adicional</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body adicionais-form"><div><label for="edit-nome-@adicional.Id">Nome</label><input id="edit-nome-@adicional.Id" name="Nome" required maxlength="160" value="@adicional.Nome" /></div><div><label for="edit-preco-@adicional.Id">Preço</label><input id="edit-preco-@adicional.Id" name="Preco" type="number" min="0" step="0.01" required value="@adicional.Preco.ToString("0.00", CultureInfo.InvariantCulture)" /></div><div><label for="edit-maximo-@adicional.Id">Máximo de seleção</label><input id="edit-maximo-@adicional.Id" name="MaximoSelecao" type="number" min="1" max="100" value="@adicional.MaximoSelecao" /></div><div class="adicionais-form__wide"><label for="edit-descricao-@adicional.Id">Descrição</label><textarea id="edit-descricao-@adicional.Id" name="Descricao" rows="3">@adicional.Descricao</textarea></div><fieldset class="adicionais-form__wide"><legend>Categorias</legend><div class="adicionais-checks">@foreach (var categoria in Model.Categorias) { <label><input type="checkbox" name="CategoriaIds" value="@categoria.Id" checked="@adicional.CategoriaIds.Contains(categoria.Id)" /> @categoria.Nome</label> }</div></fieldset><label class="adicionais-toggle adicionais-form__wide"><input type="checkbox" name="Ativo" value="true" checked="@adicional.Ativo" /> Adicional ativo</label></div><div class="modal-footer"><button type="button" class="btn adicionais-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn adicionais-primary">Salvar alterações</button></div></form></div></div>
        <div class="modal fade" id="excluirAdicional-@adicional.Id" tabindex="-1" aria-labelledby="excluirAdicionalTitulo-@adicional.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content adicionais-modal" asp-action="Excluir" asp-route-slug="@Model.Slug" asp-route-id="@adicional.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="excluirAdicionalTitulo-@adicional.Id">Excluir adicional</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p>Deseja realmente excluir este adicional?</p><strong>@adicional.Nome</strong><p class="adicionais-muted">Esta ação não poderá ser desfeita.</p></div><div class="modal-footer"><button type="button" class="btn adicionais-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn adicionais-danger">Excluir adicional</button></div></form></div></div> } </section> }
</main>
<div class="modal fade" id="novoAdicionalModal" tabindex="-1" aria-labelledby="novoAdicionalTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content adicionais-modal" asp-action="Criar" asp-route-slug="@Model.Slug" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="novoAdicionalTitulo">Novo Adicional</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body adicionais-form"><div><label asp-for="NovoAdicional.Nome">Nome</label><input asp-for="NovoAdicional.Nome" required /></div><div><label asp-for="NovoAdicional.Preco">Preço</label><input asp-for="NovoAdicional.Preco" type="number" min="0" step="0.01" required /></div><div><label asp-for="NovoAdicional.MaximoSelecao">Máximo de seleção</label><input asp-for="NovoAdicional.MaximoSelecao" type="number" min="1" max="100" /></div><div class="adicionais-form__wide"><label asp-for="NovoAdicional.Descricao">Descrição</label><textarea asp-for="NovoAdicional.Descricao" rows="3"></textarea></div><fieldset class="adicionais-form__wide"><legend>Categorias</legend><div class="adicionais-checks">@foreach (var categoria in Model.Categorias) { <label><input type="checkbox" name="NovoAdicional.CategoriaIds" value="@categoria.Id" /> @categoria.Nome</label> }</div></fieldset><label class="adicionais-toggle adicionais-form__wide"><input asp-for="NovoAdicional.Ativo" /> Adicional ativo</label></div><div class="modal-footer"><button type="button" class="btn adicionais-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn adicionais-primary">Salvar adicional</button></div></form></div></div>
