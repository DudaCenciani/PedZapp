@using System.Globalization
@model PedZapp.ViewModels.Entrega.EntregasIndexViewModel
@{ ViewData["Title"] = "Entregas e taxas"; var cultura = new CultureInfo("pt-BR"); }
<link rel="stylesheet" href="~/css/entregas.css" asp-append-version="true" />
<main class="entregas-page">
    @* Reutiliza o botão comum para voltar ao painel do mesmo slug. *@
    <partial name="_BotaoVoltarPainel" model="Model.Slug" />
<header class="entregas-header"><div><p class="entregas-eyebrow">Operação · @Model.Slug</p><h1>Entregas e taxas</h1><p>Defina os bairros atendidos e os valores de entrega.</p></div><button class="btn entregas-primary" type="button" data-bs-toggle="modal" data-bs-target="#novoBairroModal"><span aria-hidden="true">+</span> Novo bairro</button></header>
@if (TempData["Sucesso"] is string sucesso){<div class="entregas-feedback" role="status">@sucesso</div>}
<form class="entregas-filtros" method="get" asp-action="Index" asp-route-slug="@Model.Slug"><input name="busca" value="@Model.Busca" placeholder="Buscar por bairro" aria-label="Buscar por bairro"/><select name="status" aria-label="Filtrar por status"><option value="">Todos</option><option value="ativo" selected="@(Model.Status == "ativo")">Ativos</option><option value="inativo" selected="@(Model.Status == "inativo")">Inativos</option></select><button class="btn entregas-filter" type="submit">Filtrar</button><span>@Model.Bairros.Count bairro@(Model.Bairros.Count == 1 ? string.Empty : "s")</span></form>
@if (!Model.Bairros.Any()){<section class="entregas-empty"><span aria-hidden="true">⌖</span><h2>Nenhum bairro cadastrado</h2><p>Cadastre os bairros atendidos pela sua empresa e defina as taxas de entrega.</p><button class="btn entregas-primary" type="button" data-bs-toggle="modal" data-bs-target="#novoBairroModal">Cadastrar primeiro bairro</button></section>}
else{<section class="entregas-grid" aria-label="Bairros de entrega">@foreach(var bairro in Model.Bairros){<article class="entrega-card"><div class="entrega-card__head"><h2>@bairro.NomeBairro</h2><span class="entrega-status @(bairro.Ativo ? "entrega-status--active" : "entrega-status--inactive")">@(bairro.Ativo ? "Ativo" : "Inativo")</span></div><strong class="entrega-card__taxa">R$ @bairro.TaxaEntrega.ToString("N2",cultura)</strong><dl><div><dt>Tempo estimado</dt><dd>@(bairro.TempoEstimadoEntregaMinutos.HasValue ? $"{bairro.TempoEstimadoEntregaMinutos} min" : "Não informado")</dd></div><div><dt>Pedido mínimo</dt><dd>@(bairro.PedidoMinimo.HasValue ? $"R$ {bairro.PedidoMinimo.Value.ToString("N2", cultura)}" : "Não informado")</dd></div><div><dt>Ordem</dt><dd>@bairro.OrdemExibicao</dd></div></dl><div class="entrega-actions"><button class="btn entrega-edit" type="button" data-bs-toggle="modal" data-bs-target="#editarBairro-@bairro.Id"><span aria-hidden="true">✎</span> Editar</button><button class="btn entrega-delete" type="button" data-bs-toggle="modal" data-bs-target="#excluirBairro-@bairro.Id"><span aria-hidden="true">⌫</span> Excluir</button></div></article>
<div class="modal fade" id="editarBairro-@bairro.Id" tabindex="-1" aria-labelledby="editarBairroTitulo-@bairro.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content entregas-modal" asp-action="Editar" asp-route-slug="@Model.Slug" asp-route-id="@bairro.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="editarBairroTitulo-@bairro.Id">Editar bairro</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body entregas-form"><div class="entregas-wide"><label for="edit-nome-@bairro.Id">Nome do bairro</label><input id="edit-nome-@bairro.Id" name="NomeBairro" maxlength="160" required value="@bairro.NomeBairro"/></div><div><label for="edit-taxa-@bairro.Id">Taxa de entrega</label><input id="edit-taxa-@bairro.Id" name="TaxaEntrega" type="number" min="0" step="0.01" required value="@bairro.TaxaEntrega.ToString("0.00",CultureInfo.InvariantCulture)"/></div><div><label for="edit-tempo-@bairro.Id">Tempo estimado (min.)</label><input id="edit-tempo-@bairro.Id" name="TempoEstimadoEntregaMinutos" type="number" min="1" max="1440" value="@bairro.TempoEstimadoEntregaMinutos"/></div><div><label for="edit-minimo-@bairro.Id">Pedido mínimo</label><input id="edit-minimo-@bairro.Id" name="PedidoMinimo" type="number" min="0" step="0.01" value="@(bairro.PedidoMinimo?.ToString("0.00",CultureInfo.InvariantCulture))"/></div><div><label for="edit-ordem-@bairro.Id">Ordem de exibição</label><input id="edit-ordem-@bairro.Id" name="OrdemExibicao" type="number" min="0" value="@bairro.OrdemExibicao"/></div><label class="entregas-toggle entregas-wide"><input type="checkbox" name="Ativo" value="true" checked="@bairro.Ativo"/> Bairro ativo</label></div><div class="modal-footer"><button type="button" class="btn entregas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn entregas-primary">Salvar bairro</button></div></form></div></div>
<div class="modal fade" id="excluirBairro-@bairro.Id" tabindex="-1" aria-labelledby="excluirBairroTitulo-@bairro.Id" aria-hidden="true"><div class="modal-dialog modal-dialog-centered"><form class="modal-content entregas-modal" asp-action="Excluir" asp-route-slug="@Model.Slug" asp-route-id="@bairro.Id" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="excluirBairroTitulo-@bairro.Id">Excluir bairro</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body"><p>Deseja realmente excluir <strong>@bairro.NomeBairro</strong>?</p><p>Taxa cadastrada: <strong>R$ @bairro.TaxaEntrega.ToString("N2",cultura)</strong></p><p class="entregas-muted">O bairro deixará de estar disponível para novos pedidos.</p></div><div class="modal-footer"><button type="button" class="btn entregas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn entregas-danger">Excluir bairro</button></div></form></div></div>}}</section>}
</main>
<div class="modal fade" id="novoBairroModal" tabindex="-1" aria-labelledby="novoBairroTitulo" aria-hidden="true"><div class="modal-dialog modal-dialog-scrollable modal-lg"><form class="modal-content entregas-modal" asp-action="Criar" asp-route-slug="@Model.Slug" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 id="novoBairroTitulo">Novo bairro</h2><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fechar"></button></div><div class="modal-body entregas-form"><div asp-validation-summary="ModelOnly" class="text-danger entregas-wide"></div><div class="entregas-wide"><label asp-for="NovoBairro.NomeBairro">Nome do bairro</label><input asp-for="NovoBairro.NomeBairro" required/></div><div><label asp-for="NovoBairro.TaxaEntrega">Taxa de entrega</label><input asp-for="NovoBairro.TaxaEntrega" type="number" min="0" step="0.01" required/></div><div><label asp-for="NovoBairro.TempoEstimadoEntregaMinutos">Tempo estimado (min.)</label><input asp-for="NovoBairro.TempoEstimadoEntregaMinutos" type="number" min="1" max="1440"/></div><div><label asp-for="NovoBairro.PedidoMinimo">Pedido mínimo</label><input asp-for="NovoBairro.PedidoMinimo" type="number" min="0" step="0.01"/></div><div><label asp-for="NovoBairro.OrdemExibicao">Ordem de exibição</label><input asp-for="NovoBairro.OrdemExibicao" type="number" min="0"/></div><label class="entregas-toggle entregas-wide"><input asp-for="NovoBairro.Ativo"/> Bairro ativo</label></div><div class="modal-footer"><button type="button" class="btn entregas-cancel" data-bs-dismiss="modal">Cancelar</button><button type="submit" class="btn entregas-primary">Salvar bairro</button></div></form></div></div>
