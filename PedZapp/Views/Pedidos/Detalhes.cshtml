@using PedZapp.Enums
@using System.Globalization
@model PedZapp.ViewModels.Pedido.PedidoDetalhesViewModel
@{ ViewData["Title"] = $"Pedido #{Model.NumeroPedido}"; var cultura = new CultureInfo("pt-BR"); }
<link rel="stylesheet" href="~/css/pedidos.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/pedido-impressao-admin.css" asp-append-version="true" />
@* Mantém o retorno ao painel da empresa sem interferir nas ações de impressão do pedido. *@
<partial name="_BotaoVoltarPainel" model="Model.Slug" />
<main class="pedido-details"><a asp-action="Index" asp-route-slug="@Model.Slug">← Voltar aos pedidos</a><header><div><p>Pedido #@Model.NumeroPedido</p><h1>@Model.NomeCliente</h1><span>@Model.Status · @Model.DataCriacao.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>@if (Model.UltimaImpressaoStatus.HasValue) { <small class="pedido-print-status">Impressão: @TextoImpressao(Model.UltimaImpressaoStatus.Value)</small> }</div><strong>R$ @Model.Total.ToString("N2", cultura)</strong></header><section class="pedido-print-actions" aria-label="Ações de impressão"><form asp-action="SolicitarImpressao" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" asp-route-tipo="@TipoImpressao.Cozinha" method="post" target="_blank">@Html.AntiForgeryToken()<button type="submit">🖨 Imprimir cozinha</button></form><form asp-action="SolicitarImpressao" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" asp-route-tipo="@TipoImpressao.Entrega" method="post" target="_blank">@Html.AntiForgeryToken()<button type="submit">🖨 Imprimir entrega</button></form><form asp-action="SolicitarImpressao" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" asp-route-tipo="@TipoImpressao.Comprovante" method="post" target="_blank">@Html.AntiForgeryToken()<button type="submit">🖨 Imprimir comprovante</button></form><form asp-action="SolicitarImpressao" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" asp-route-tipo="@TipoImpressao.Cozinha" method="post" target="_blank">@Html.AntiForgeryToken()<button class="reprint" type="submit">↻ Reimprimir</button></form></section><section class="pedido-details__grid"><article><h2>Cliente e atendimento</h2><p><strong>Telefone:</strong> @Model.TelefoneCliente</p><p><strong>Atendimento:</strong> @(Model.TipoAtendimento == TipoAtendimento.Entrega ? "Entrega" : "Retirada")</p>@if (Model.TipoAtendimento == TipoAtendimento.Entrega) { <p><strong>Endereço:</strong> @Model.Rua, @Model.NumeroEndereco · @Model.Bairro</p>@if (!string.IsNullOrWhiteSpace(Model.Complemento)) { <p>@Model.Complemento</p> }@if (!string.IsNullOrWhiteSpace(Model.Referencia)) { <p>Referência: @Model.Referencia</p> } }</article><article><h2>Pagamento</h2><p><strong>@Model.FormaPagamento</strong> · @(Model.Pago ? "Pago" : "Pendente")</p>@if (Model.PrecisaTroco) { <p>Troco para R$ @Model.TrocoPara?.ToString("N2", cultura)</p> }<p>Taxa de entrega: R$ @Model.TaxaEntrega.ToString("N2", cultura)</p></article>@if (Model.AceitaAtualizacoesWhatsApp) { <article><h2>WhatsApp</h2>@if (Model.WhatsAppConfirmacaoEnviadaEm.HasValue) { <p>✓ Confirmação enviada.</p> } else if (Model.WhatsAppConfirmacaoFalhouEm.HasValue) { <p>! Não foi possível enviar a confirmação.</p><form asp-action="ReenviarWhatsApp" asp-route-slug="@Model.Slug" asp-route-id="@Model.Id" method="post">@Html.AntiForgeryToken()<button type="submit">Tentar novamente</button></form> } else { <p>Confirmação ainda não enviada.</p> }</article> }</section><section class="pedido-items"><h2>Itens</h2>@foreach (var item in Model.Itens) { <article><div><strong>@item.Quantidade× @item.Nome</strong><span>R$ @item.Subtotal.ToString("N2", cultura)</span></div>@if (item.Adicionais.Any()) { <p>Adicionais: @string.Join(", ", item.Adicionais.Select(a => a.Nome))</p> }@if (!string.IsNullOrWhiteSpace(item.Observacao)) { <p>Obs.: @item.Observacao</p> }</article> }<footer><span>Subtotal: R$ @Model.Subtotal.ToString("N2", cultura)</span><strong>Total: R$ @Model.Total.ToString("N2", cultura)</strong></footer></section></main>
@functions { private static string TextoImpressao(StatusImpressao status) => status switch { StatusImpressao.Pendente => "pendente", StatusImpressao.Processando => "janela aberta", StatusImpressao.Solicitada => "solicitada", StatusImpressao.Falhou => "falhou", _ => "cancelada" }; }
